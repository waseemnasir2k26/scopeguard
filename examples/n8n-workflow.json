{
  "name": "scopeguard: client email to possible-extras alert (no drafts, nothing sent)",
  "nodes": [
    {
      "parameters": {
        "content": "## scopeguard (suggests; you decide)\n1. Create a Gmail label for ONE client and put its id in the trigger filter.\n2. Run `scopeguard serve --sow sow.md --rates rates.yaml --client \"Client Full Name\"` on a machine this n8n can reach (127.0.0.1 if same box).\n3. Create a Header Auth credential `Authorization: Bearer <token>` when the server is not loopback-only.\n4. This workflow only POSTS the email text to scopeguard and posts an INTERNAL Slack alert listing possible extras. It writes no change-order drafts and sends nothing to the client.\n5. To draft a change order for an item you agree with, run `scopeguard bill <id>` yourself.",
        "height": 260,
        "width": 480
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Read me",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -120,
        -140
      ]
    },
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "labelIds": [
            "REPLACE_WITH_CLIENT_LABEL_ID"
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Gmail Trigger (client label)",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_ME",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const from = (j.from && j.from.text) || 'Client';\n  const body = String(j.text || j.snippet || '').slice(0, 20000);\n  const raw = `From: ${from}\\nSubject: ${j.subject || ''}\\nDate: ${j.date || new Date().toUTCString()}\\n\\n${body}`;\n  out.push({ json: { messages: raw, format: 'eml', subject: j.subject || '', from } });\n}\nreturn out;"
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Code (build request)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8765/analyze",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messages: $json.messages, format: $json.format, client: ['REPLACE_WITH_CLIENT_FULL_NAME'], tone: 'friendly' }) }}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "scopeguard /analyze",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "scopeguard token"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.possible_extras_count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Any possible extras?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        720,
        200
      ]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "REPLACE_WITH_CHANNEL_ID",
          "mode": "id"
        },
        "text": "={{ ':mag: scopeguard: ' + $json.headline + ' in \"' + $('Code (build request)').item.json.subject + '\". Nothing was drafted or sent.\\n' + $json.possible_extras.map(x => '- ' + x.quote + ' [' + (x.clause_id || 'no clause') + ', ' + x.fingerprint + ']').join('\\n') }}",
        "otherOptions": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Slack: possible extras (internal)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        960,
        120
      ],
      "credentials": {
        "slackApi": {
          "id": "REPLACE_ME",
          "name": "Slack account"
        }
      }
    }
  ],
  "connections": {
    "Gmail Trigger (client label)": {
      "main": [
        [
          {
            "node": "Code (build request)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code (build request)": {
      "main": [
        [
          {
            "node": "scopeguard /analyze",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "scopeguard /analyze": {
      "main": [
        [
          {
            "node": "Any possible extras?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any possible extras?": {
      "main": [
        [
          {
            "node": "Slack: possible extras (internal)",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}