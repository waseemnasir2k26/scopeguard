{
  "name": "scopeguard: client email to scope check to DRAFT alert",
  "nodes": [
    {
      "parameters": {
        "content": "## scopeguard (drafts only)\n1. Create a Gmail label for ONE client and put its id in the trigger filter.\n2. Run `scopeguard serve --sow sow.md --rates rates.yaml --client \"Client Name\"` on a machine this n8n can reach (127.0.0.1 if n8n runs on the same box).\n3. Create a Header Auth credential `Authorization: Bearer <token>` when the server is not loopback-only.\n4. Nothing in this workflow sends mail to the client. The Gmail node only CREATES A DRAFT in your own mailbox; the Slack node posts an internal alert.\n5. LLM judgement is a draft. You decide what to raise.",
        "height": 260,
        "width": 480
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Read me",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-120, -140]
    },
    {
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyMinute" }] },
        "simple": false,
        "filters": { "labelIds": ["REPLACE_WITH_CLIENT_LABEL_ID"] },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Gmail Trigger (client label)",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [0, 200],
      "credentials": {
        "gmailOAuth2": { "id": "REPLACE_ME", "name": "Gmail account" }
      }
    },
    {
      "parameters": {
        "jsCode": "const out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const from = (j.from && j.from.text) || 'Client';\n  const body = String(j.text || j.snippet || '').slice(0, 20000);\n  const raw = `From: ${from}\\nSubject: ${j.subject || ''}\\nDate: ${j.date || new Date().toUTCString()}\\n\\n${body}`;\n  out.push({ json: { messages: raw, format: 'eml', subject: j.subject || '', from } });\n}\nreturn out;"
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Code (build request)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8765/analyze",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messages: $json.messages, format: $json.format, tone: 'friendly' }) }}",
        "options": { "timeout": 600000 }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "scopeguard /analyze",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 200],
      "credentials": {
        "httpHeaderAuth": { "id": "REPLACE_ME", "name": "scopeguard token" }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.out_of_scope_count }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Any out-of-scope?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, 200]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "value": "REPLACE_WITH_CHANNEL_ID",
          "mode": "id"
        },
        "text": "={{ ':warning: DRAFT scope alert: ' + $json.out_of_scope_count + ' out-of-scope request(s) in \"' + $('Code (build request)').item.json.subject + '\". Nothing was sent. First draft:\\n' + Object.values($json.drafts)[0].slice(0, 1500) }}",
        "otherOptions": {}
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Slack: draft alert (internal)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [960, 120],
      "credentials": {
        "slackApi": { "id": "REPLACE_ME", "name": "Slack account" }
      }
    },
    {
      "parameters": {
        "resource": "draft",
        "operation": "create",
        "subject": "={{ 'DRAFT change order: ' + $('Code (build request)').item.json.subject }}",
        "message": "={{ Object.values($json.drafts).join('\\n\\n----------\\n\\n') }}",
        "options": { "sendTo": "REPLACE_WITH_YOUR_OWN_EMAIL" }
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Gmail: create DRAFT in my mailbox",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [960, 300],
      "credentials": {
        "gmailOAuth2": { "id": "REPLACE_ME", "name": "Gmail account" }
      }
    }
  ],
  "connections": {
    "Gmail Trigger (client label)": {
      "main": [[{ "node": "Code (build request)", "type": "main", "index": 0 }]]
    },
    "Code (build request)": {
      "main": [[{ "node": "scopeguard /analyze", "type": "main", "index": 0 }]]
    },
    "scopeguard /analyze": {
      "main": [[{ "node": "Any out-of-scope?", "type": "main", "index": 0 }]]
    },
    "Any out-of-scope?": {
      "main": [
        [
          {
            "node": "Slack: draft alert (internal)",
            "type": "main",
            "index": 0
          },
          {
            "node": "Gmail: create DRAFT in my mailbox",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": false }
}
